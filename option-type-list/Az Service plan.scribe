resource "option-type-list" "Az Service plan" {
  name = "Az Service plan"
  uuid = "94749cf4-5043-4dc3-8d50-8fe1ba77c2b2"
  apiType = "servicePlans"
  realTime = true
  requestScript = <<EOFSCRIBE
results.siteId = input.input1
results.zoneId = input.input2
EOFSCRIBE
  translationScript = <<EOFSCRIBE
if (input.input1 && input.input2) {
for (var x = 0; x < data.length; x++) {
results.push({name:data[x].name, value:data[x].value});
}
}
EOFSCRIBE
  type = "api"
  visibility = "public"
}